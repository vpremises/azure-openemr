# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

.env
ansible/inventory/hosts.ini

/target/

# Local registration, runtime data and secrets (never source defaults).
/registration/
/.local/
/state/
/.state/
/.data/
/secrets/
/credentials/
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.local.toml
*.local.json
*.local.yaml
*.local.yml
# Dependencies, caches and generated build/test output.
node_modules/
target/
/.nuxt/
/.output/
/dist/
/build/
/coverage/
/.cache/
/.pytest_cache/
.venv/
__pycache__/
*.py[cod]
*.tsbuildinfo
*.log
.DS_Store

# Root runtime databases and local artifact/test outputs.
/*.sqlite*
/*.db
/*.db-wal
/*.db-shm
/*.db-journal
/.artifacts/
/playwright-report/
/test-results/
/.turbo/
/.vite/
/.pnpm-store/

**/.nuxt/

**/.output/

**/node_modules/


*.vsix

*.pre-*

# Generated package archives are local build outputs.
*.tgz

# Generated archives, local caches, and coverage reports.
/*.tgz
/*.tar.gz
/*.tar
/*.zip
/*.whl
/*.crate
/.ruff_cache/
/.mypy_cache/
/.tox/
/.nox/
/.hypothesis/
/.coverage
/.coverage.*
/htmlcov/
/lcov.info
/junit.xml
/*.profraw
/*.profdata
/*.egg-info/

# Retained source files in legacy source directories.


# Generated operational inventory and cloud plans.
/ansible/inventory/hosts.ini
/plan.json
*.tfplan
*.tfstate
*.tfstate.*
**/.terraform/
